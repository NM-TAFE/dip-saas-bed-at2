# The image copies no project files (code is bind-mounted at runtime).
# This guards against a future `COPY . .` baking secrets or bulk into an image.

# Secrets
.env
.env.*
!.env.example

# Installed dependencies (install inside the image instead)
vendor
node_modules

# Git, runtime data (logs, local uploads), local tooling
.git
storage/app/*
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.DS_Store
.idea
.vscode
